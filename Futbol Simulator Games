<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>⚽ FOOTBALL GAMES Simulator</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #050608;
            color: white;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* =========================
           FONDO PRINCIPAL
        ========================= */

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -3;

            background:
                linear-gradient(
                    180deg,
                    rgba(0,0,0,0.30) 0%,
                    rgba(0,0,0,0.58) 50%,
                    rgba(3,5,7,0.98) 100%
                ),
                url("https://images.unsplash.com/photo-1522778119026-d647f0596c20?auto=format&fit=crop&w=2400&q=85")
                center center / cover no-repeat;
        }

        body::after {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -2;

            background:
                radial-gradient(
                    circle at 50% 20%,
                    rgba(255,255,255,0.08),
                    transparent 35%
                ),
                linear-gradient(
                    90deg,
                    rgba(0,0,0,0.45),
                    transparent 50%,
                    rgba(0,0,0,0.45)
                );
        }

        /* =========================
           NAVBAR
        ========================= */

        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 76px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 6%;

            background: rgba(4, 6, 9, 0.72);
            backdrop-filter: blur(14px);

            border-bottom: 1px solid rgba(255,255,255,0.08);

            z-index: 100;
        }

        .logo {
            font-size: 21px;
            font-weight: 900;
            letter-spacing: 0.5px;
        }

        .logo span {
            color: #42ff88;
        }

        .nav-right {
            display: flex;
            gap: 28px;
            align-items: center;
        }

        .nav-right a {
            color: #d9d9d9;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            transition: 0.25s;
        }

        .nav-right a:hover {
            color: #42ff88;
        }

        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 570px;

            display: flex;
            align-items: center;
            justify-content: center;

            text-align: center;

            padding: 130px 20px 80px;
        }

        .hero-content {
            max-width: 950px;
        }

        .mini-title {
            display: inline-block;

            padding: 8px 16px;
            margin-bottom: 22px;

            border: 1px solid rgba(66,255,136,0.4);
            border-radius: 30px;

            background: rgba(66,255,136,0.08);

            color: #42ff88;

            font-size: 12px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        h1 {
            font-size: clamp(48px, 8vw, 92px);
            line-height: 0.95;
            font-weight: 950;
            letter-spacing: -4px;

            text-shadow:
                0 5px 30px rgba(0,0,0,0.7);
        }

        h1 .green {
            color: #42ff88;
        }

        .hero-description {
            max-width: 700px;
            margin: 28px auto 0;

            color: #d0d0d0;

            font-size: 18px;
            line-height: 1.7;
        }

        /* =========================
           BOTÓN
        ========================= */

        .hero-button {
            display: inline-block;

            margin-top: 35px;
            padding: 15px 28px;

            border-radius: 9px;

            background: #42ff88;
            color: #061009;

            text-decoration: none;

            font-size: 14px;
            font-weight: 900;

            box-shadow:
                0 10px 35px rgba(66,255,136,0.18);

            transition: 0.3s;
        }

        .hero-button:hover {
            transform: translateY(-3px);
            box-shadow:
                0 15px 45px rgba(66,255,136,0.3);
        }

        /* =========================
           SECCIÓN JUEGOS
        ========================= */

        .games-section {
            max-width: 1250px;
            margin: 0 auto;

            padding: 70px 25px 120px;
        }

        .section-heading {
            text-align: center;
            margin-bottom: 45px;
        }

        .section-heading h2 {
            font-size: 38px;
            font-weight: 900;
            letter-spacing: -1px;
        }

        .section-heading p {
            margin-top: 10px;
            color: #999;
            font-size: 15px;
        }

        /* =========================
           GRID
        ========================= */

        .games-grid {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 22px;
        }

        /* =========================
           TARJETAS
        ========================= */

        .game-card {
            position: relative;

            min-height: 260px;

            display: flex;
            flex-direction: column;
            justify-content: flex-end;

            padding: 28px;

            overflow: hidden;

            border-radius: 16px;

            background:
                linear-gradient(
                    180deg,
                    rgba(15,18,22,0.45),
                    rgba(5,7,9,0.96)
                );

            border: 1px solid rgba(255,255,255,0.10);

            box-shadow:
                0 15px 40px rgba(0,0,0,0.25);

            transition:
                transform 0.35s ease,
                border-color 0.35s ease,
                box-shadow 0.35s ease;
        }

        .game-card::before {
            content: "";

            position: absolute;
            width: 180px;
            height: 180px;

            top: -90px;
            right: -60px;

            border-radius: 50%;

            background: rgba(66,255,136,0.12);

            filter: blur(10px);

            transition: 0.4s;
        }

        .game-card:hover {
            transform: translateY(-7px);

            border-color: rgba(66,255,136,0.45);

            box-shadow:
                0 20px 55px rgba(0,0,0,0.45),
                0 0 35px rgba(66,255,136,0.06);
        }

        .game-card:hover::before {
            transform: scale(1.5);
        }

        .card-number {
            position: absolute;
            top: 20px;
            right: 22px;

            color: rgba(255,255,255,0.16);

            font-size: 45px;
            font-weight: 900;
        }

        .card-tag {
            display: inline-block;

            width: fit-content;

            padding: 6px 10px;
            margin-bottom: 14px;

            border-radius: 5px;

            background: rgba(66,255,136,0.10);
            color: #42ff88;

            font-size: 10px;
            font-weight: 900;
            letter-spacing: 1px;
        }

        .game-card h3 {
            position: relative;

            font-size: 26px;
            font-weight: 900;

            margin-bottom: 10px;
        }

        .game-card p {
            position: relative;

            color: #aaa;

            font-size: 14px;
            line-height: 1.55;

            max-width: 390px;
        }

        .play-button {
            position: relative;

            width: fit-content;

            margin-top: 20px;

            padding: 10px 17px;

            border-radius: 7px;

            background: rgba(255,255,255,0.08);

            color: white;

            font-size: 12px;
            font-weight: 800;

            text-decoration: none;

            border: 1px solid rgba(255,255,255,0.12);

            transition: 0.25s;
        }

        .play-button:hover {
            background: #42ff88;
            color: #061009;
            border-color: #42ff88;
        }

        /* =========================
           PRÓXIMAMENTE
        ========================= */

        .coming-soon {
            opacity: 0.65;
        }

        .coming-soon:hover {
            opacity: 0.9;
            transform: translateY(-4px);
        }

        .coming-soon .card-tag {
            background: rgba(255,255,255,0.07);
            color: #aaa;
        }

        .coming-soon h3 {
            color: #ddd;
        }

        .coming-soon p {
            color: #777;
        }

        .soon-label {
            position: relative;

            margin-top: 20px;

            width: fit-content;

            padding: 9px 15px;

            border-radius: 6px;

            background: rgba(255,255,255,0.05);

            color: #777;

            font-size: 11px;
            font-weight: 900;
            letter-spacing: 1px;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            padding: 30px 20px;

            text-align: center;

            background: rgba(0,0,0,0.65);

            border-top: 1px solid rgba(255,255,255,0.07);

            color: #666;

            font-size: 12px;
        }

        footer strong {
            color: #42ff88;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 900px) {

            .games-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            h1 {
                letter-spacing: -2px;
            }
        }

        @media (max-width: 600px) {

            nav {
                padding: 0 20px;
            }

            .nav-right {
                display: none;
            }

            .hero {
                min-height: 520px;
            }

            .hero-description {
                font-size: 15px;
            }

            .games-grid {
                grid-template-columns: 1fr;
            }

            .game-card {
                min-height: 240px;
            }

            .section-heading h2 {
                font-size: 30px;
            }
        }
    </style>
</head>

